+
+    // 9. Provider returning AAL1 after verify fails closed
+    const aal1StuckMock = createMockExternalSupabaseClient({
+      validCode: '654321',
+      postVerifyAal: 'aal1',
+      initialFactors: [{ id: 'f-stuck', factor_type: 'totp', status: 'unverified' }],
