# ==============================================================================
# Celebration Sisters Event Decor — Environment Variable Manifest (.env.example)
# Copy to .env for local development. NEVER commit real secrets to Git.
# ==============================================================================

# --- Application Runtime ---
NODE_ENV=development
PORT=3000
APP_URL=

# --- Frontend Public Build Variables (Safe for Client Bundle) ---
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Database & Persistence (PostgreSQL / Supabase) ---
# Production requires PERSISTENCE_ADAPTER=postgres and DATABASE_URL.
PERSISTENCE_ADAPTER=json-local
DATABASE_URL=
PG_POOL_MAX=10
PG_CONNECT_TIMEOUT_MS=5000
PG_SSL_REJECT_UNAUTHORIZED=true
# Local development JSON store path (ignored in production)
CS_DB_PATH=

# --- Supabase Authentication & Server-Side Verification ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# --- Session, Cookies, CORS, Proxy & Security ---
# Production requires SESSION_SECRET >= 24 high-entropy characters.
SESSION_SECRET=
ALLOWED_ORIGINS=http://localhost:3000,https://ophireumtechnology.github.io
CROSS_ORIGIN_COOKIES=false
# Number of trusted reverse-proxy hops (1 for Railway; false for direct local dev)
TRUST_PROXY=1
# PostgreSQL rate-limit query timeout in milliseconds (fail-closed on auth/MFA endpoints)
RATE_LIMIT_DB_TIMEOUT_MS=2500
# Non-production development MFA fallback only (strictly disabled when NODE_ENV=production)
ADMIN_MFA_PASSCODE=
# Development-only role switcher override (strictly disabled when NODE_ENV=production)
ALLOW_DEMO_AUTH=false

# --- Server Timeouts, Observability & Outbox Worker ---
HTTP_REQUEST_TIMEOUT_MS=30000
OUTBOX_POLL_INTERVAL_MS=5000
LOG_HTTP_REQUESTS=false

# --- Email Notifications (Resend Transactional Outbox) ---
RESEND_API_KEY=
EMAIL_FROM=
STAFF_NOTIFICATION_EMAIL=
# Must be explicitly set to "true" only after verified domain + owner approval
EMAIL_LIVE_DELIVERY_ENABLED=false

# --- AI Services (Server-Side Only) ---
GEMINI_API_KEY=